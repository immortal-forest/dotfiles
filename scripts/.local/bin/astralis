COMPACT = ["✦  " + " ".join("astralis")]


def _blank(rows, cols):
    return [" " * cols] * rows


def _lockup(word):
    """Crystal beside the wordmark, two rows taller above and below so its
    spikes reach past the letters."""
    rows = len(word) + 4
    cols = round(rows * 2.08)
    pad = [" " * max(map(len, word))] * 2
    return [" " * (cols + 4) + w for w in pad + word + pad], (0, 0, rows, cols), 2


