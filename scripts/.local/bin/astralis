#!/usr/bin/env python3
"""astralis — the astralis wordmark, live in the terminal.

Outfit SemiBold (the shell's UI font) and a turning crystal star, drawn in block
sextants and coloured from the live wallpaper palette (the Colors.json matugen
writes for the shell) over the terminal's own background, so it stays as
translucent as the window. In a terminal it runs full screen until a key is
pressed; -o plays the intro inline and exits; -s prints once; --bg paints a
nebula behind it (for opaque terminals: explicit cell colours are drawn opaque,
so in a translucent one the nebula reads as a dark box).
"""
import argparse, json, math, os, random, select, shutil, signal, sys, time

