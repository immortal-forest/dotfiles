WALLPAPER = os.path.expanduser("~/.cache/astralis/current-wallpaper")

# All art is block sextants (2x3 pixels per cell), supersampled and corrected
# for Obel Mono's 2.08:1 cells so shapes keep their true proportions.
#
# Wordmark: Outfit SemiBold (the shell's UI font), caps, tracking .14em (6 rows)
# .08em (5 rows, fits 80 columns) and .1em (4 rows, fits 66).
# Icon: a crystal star (see "crystal" below), rendered live, not stored here.
