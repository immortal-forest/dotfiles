.badge{background:rgba(0,0,0,.65);border-radius:999px;padding:2px 9px;font-size:12px}
.badge.have{background:rgba(40,90,60,.9);color:var(--ok)}
.badge.dup{background:rgba(100,80,30,.9);color:var(--warn)}
.row{display:flex;align-items:center;gap:8px;padding:9px 12px}
.ttl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row.f input{flex:1;min-width:0;padding:5px 12px;font-size:13px}
.row button{padding:5px 14px;font-size:13px}
.get{background:var(--acc);color:#0b0d14;border-color:var(--acc);font-weight:600}
.bar{height:3px;background:var(--surf2)}.bar i{display:block;height:100%;width:0;background:var(--acc);transition:width .3s}
.err{color:var(--err);font-size:12px;padding:0 12px 10px}
#more{display:block;margin:0 auto 40px;padding:10px 28px}
</style></head><body>
<header>
  <h1>wallgrab</h1>
  <input id="q" placeholder="Search (e.g. wuthering waves)" autocomplete="off">
  <select id="source"><option value="all">All sources</option><option>motionbgs</option><option>desktophut</option><option>wallhaven</option><option>konachan</option><option>yande.re</option><option>pixiv</option></select>
  <select id="kind"><option value="all">Videos + images</option><option value="video">Videos</option><option value="image">Images</option></select>
  <button id="go">Search</button>
  <input id="filter" placeholder="Filter shown (e.g. hsin)" autocomplete="off">
  <select id="show"><option value="all">All</option><option value="new">Not in library</option><option value="have">In library</option></select>
  <div id="meta">Loading…</div>
</header>
<main id="grid"></main>
<button id="more">Load more</button>
<datalist id="folders"></datalist>
<script>
const api=(u,o={})=>fetch(u,{...o,headers:{'X-Wallgrab':'1'}});
const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const P=new URLSearchParams(location.search);
let st={q:P.get('q')||'wuthering waves',source:P.get('source')||'all',kind:P.get('kind')||'all',page:1}, items=[], dupes={}, errors={};
$('#q').value=st.q; $('#source').value=st.source; $('#kind').value=st.kind;
api('/api/folders').then(r=>r.json()).then(f=>{$('#folders').innerHTML=['auto',...f].map(x=>`<option value="${esc(x)}">`).join('')});
async function load(reset){
  if(reset){st.page=1;items=[];dupes={};$('#grid').innerHTML='';}
  $('#meta').textContent='Loading page '+st.page+'…'; $('#more').disabled=true;
  const r=await api(`/api/list?q=${encodeURIComponent(st.q)}&source=${st.source}&kind=${st.kind}&page=${st.page}`);
  const d=await r.json(); if(d.error){$('#meta').textContent='Error: '+d.error;$('#more').disabled=false;return} errors=d.errors||{};
  const seen=new Set(items.map(i=>i.uid)); const fresh=d.items.filter(i=>!seen.has(i.uid));
  items.push(...fresh); render(); $('#more').disabled=false; $('#more').style.display=fresh.length?'block':'none';
  checkDupes(fresh.filter(i=>i.kind==='image'&&!i.path));
}
async function checkDupes(list){
  if(!list.length)return;
  const body=JSON.stringify({items:list.map(i=>({uid:i.uid,hash_url:i.hash_url,referer:i.referer}))});
  while(true){
    const d=await (await api('/api/dupes',{method:'POST',body})).json();
    if(!d.pending){Object.assign(dupes,d.dupes);render();return}
    $('#meta').dataset.note='indexing your library for duplicate checks (first run only)…'; meta();
    await new Promise(r=>setTimeout(r,3000));
  }
}
function meta(){
  const have=items.filter(i=>i.path).length, dup=items.filter(i=>dupes[i.uid]).length;
  const errs=Object.entries(errors).map(([k,v])=>`<span class="err">${esc(k)}: ${esc(v)}</span>`).join(' · ');
  $('#meta').innerHTML=`${items.length} results · ${have} downloaded · ${dup} you already have · page ${st.page}`+
    ($('#meta').dataset.note&&!Object.keys(dupes).length?' · '+esc($('#meta').dataset.note):'')+(errs?' · '+errs:'');
}
function visible(){
  const f=$('#filter').value.toLowerCase().trim(), show=$('#show').value;
  return items.filter(it=>(!f||(it.title+' '+it.chars.join(' ')+' '+it.artist+' '+it.id).toLowerCase().includes(f))
    &&(show==='all'||(show==='have')===!!(it.path||dupes[it.uid])));
}
function render(){
  const g=$('#grid'), keep={};
  g.querySelectorAll('.card').forEach(c=>keep[c.dataset.uid]=c);
  const list=visible(); g.innerHTML='';
  for(const it of list){
    let c=keep[it.uid];
    const sig=(it.path||'')+'|'+(dupes[it.uid]||'');
    if(!c||c.dataset.sig!==sig){c=card(it); c.dataset.sig=sig;}
    g.appendChild(c);
  }
  meta();
}
function card(it){
  const c=document.createElement('div'); c.className='card'; c.dataset.uid=it.uid;
  const label=it.title||it.chars.join(', ')||it.artist||it.id, dup=dupes[it.uid];
  c.innerHTML=`<a class="media" href="${esc(it.page)}" target="_blank" rel="noreferrer"><img loading="lazy" referrerpolicy="no-referrer" src="${esc(it.thumb)}">
      ${it.kind==='video'?`<video muted loop playsinline preload="none" data-src="${esc(it.preview)}"></video>`:''}
      <span class="badges"><span class="badge">${esc(it.src)} · ${it.kind==='video'?'video':'image'}${it.res?' · '+esc(it.res):''}${it.pages>1?' · '+it.pages+' pages, saves p1':''}</span>
      ${it.path?'<span class="badge have">in library</span>':''}${!it.path&&dup?`<span class="badge dup" title="${esc(dup)}">have: ${esc(dup.split('/').pop())}</span>`:''}</span></a>
    <div class="row"><span class="ttl" title="${esc(label)}">${esc(label)}</span>
      ${it.path?'<button class="set">Set</button>':'<button class="get">Get</button>'}</div>
    ${it.path?'':`<div class="row f"><input list="folders" value="${esc(it.folder)}" title="Folder in ~/wallpapers (auto = decide from tags)"></div>`}
    <div class="bar"><i></i></div><div class="err"></div>`;
  const v=c.querySelector('video');
  if(v){c.addEventListener('mouseenter',()=>{if(!v.src)v.src=v.dataset.src;c.classList.add('playing');v.play().catch(()=>{})});
        c.addEventListener('mouseleave',()=>{c.classList.remove('playing');v.pause()});}
  c.querySelector('.get')?.addEventListener('click',e=>grab(it,e.target,c.querySelector('.row.f input').value));
  c.querySelector('.set')?.addEventListener('click',()=>api('/api/apply',{method:'POST',body:JSON.stringify({path:it.path})}));
  return c;
}
async function grab(it,btn,folder){btn.disabled=true;btn.textContent='Queued';
  await api('/api/get',{method:'POST',body:JSON.stringify({item:it,folder})}); poll();}
let polling=false;
async function poll(){ if(polling)return; polling=true;
  while(true){
    const j=await (await api('/api/jobs')).json(); let active=false;
    for(const [uid,s] of Object.entries(j)){
      const c=document.querySelector(`.card[data-uid="${CSS.escape(uid)}"]`); if(!c)continue;
      const b=c.querySelector('.get'), bar=c.querySelector('.bar i');
      if(s.state==='queued'||s.state==='downloading'){active=true;
        const p=s.total?Math.round(100*s.got/s.total):0; bar.style.width=p+'%'; if(b)b.textContent=s.total?p+'%':'…';}
      else if(s.state==='done'){const it=items.find(i=>i.uid===uid); if(it&&!it.path){it.path=s.path; render();}}
      else if(s.state==='error'){c.querySelector('.err').textContent=s.error; if(b){b.disabled=false;b.textContent='Retry'}}
    }
    if(!active)break; await new Promise(r=>setTimeout(r,700));
  }
  polling=false;
}
function search(){st.q=$('#q').value.trim()||'wuthering waves';st.source=$('#source').value;st.kind=$('#kind').value;
  history.replaceState(null,'',`?q=${encodeURIComponent(st.q)}&source=${st.source}&kind=${st.kind}`); load(true);}
$('#go').addEventListener('click',search); $('#q').addEventListener('keydown',e=>{if(e.key==='Enter')search()});
$('#source').addEventListener('change',search); $('#kind').addEventListener('change',search);
$('#filter').addEventListener('input',render); $('#show').addEventListener('change',render);
$('#more').addEventListener('click',()=>{st.page++;load(false)});
load(true);
</script></body></html>"""


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip()); return
    source = "all"
    if args[:1] == ["-s"] and len(args) > 1:
        source, args = args[1], args[2:]
    q = " ".join(args) or "wuthering waves"
    url = f"http://127.0.0.1:{PORT}/?" + urllib.parse.urlencode({"q": q, "source": source, "kind": "all"})
    try:
        server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    except OSError:
        webbrowser.open(url)   # already running: just open another tab
        return
    print(f"wallgrab on {url}  (Ctrl+C to stop)")
    threading.Timer(0.3, webbrowser.open, [url]).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
