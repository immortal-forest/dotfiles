#!/usr/bin/env bash
# astralis — retheme the whole shell from a wallpaper.
#   setwall <image>
# Wallpaper DISPLAY is owned by skwd-wall (skwd-walld draws via its own skwd-paper
# engine); this script is the theming half only — matugen scheme + chroma rescue +
# base16/pywal overlay + terminal live-reload — invoked by skwd per pick via its
# externalMatugenCommand hook, and by the shell on settings changes.
#
# RETHEME_ONLY=1 recolours without recording a new current-wallpaper (used for a
# live palette/boost refresh where the wallpaper itself didn't change).
# NORESCUE=1 skips the chroma rescue entirely.
set -euo pipefail

img="${1:-}"
if [ -z "$img" ]; then
    echo "usage: setwall <image>" >&2
    exit 1
fi
shift

# ── resolve a skwd-wall thumbnail back to the full wallpaper ───────────────────
# skwd-wall's externalMatugenCommand hook substitutes %path% with the cached
# THUMBNAIL (~/.cache/skwd-wall-v2/thumbs/<Folder>--<name>.webp), not the full
# image. matugen on a downscaled webp washes the extraction — the dominant colour
# collapses toward a pale tone, so most wallpapers themed nearly the same (the
# "same colour for every wallpaper" bug, on top of the scheme-vibrant collapse
# fixed below). Recover the real file so matugen (and the recorded
# current-wallpaper → lock screen) sees full resolution:
#   1. skwd's last-wallpaper.json holds the authoritative applied path+extension.
#   2. else the thumb basename "<Folder>--<name>" → ~/wallpapers/<Folder>/<name>.*
#   3. else a recursive match under ~/wallpapers.
# Non-library wallpapers that resolve to nothing keep the original path (no worse
# than before). Split on the FIRST "--" so folder/file names with hyphens survive.
case "$img" in
    "$HOME/.cache/skwd-wall-v2/thumbs/"*|"$HOME/.cache/skwd-wall-v2/thumbs-sm/"*)
        _tbase="${img##*/}"; _tbase="${_tbase%.*}"      # <Folder>--<name>
        _tfolder="${_tbase%%--*}"; _tname="${_tbase#*--}"
        _full=""
        _lw="$HOME/.cache/skwd-wall-v2/last-wallpaper.json"
        if [ -f "$_lw" ] && command -v jq >/dev/null 2>&1; then
            _cand="$(jq -r '.path // empty' "$_lw" 2>/dev/null || true)"
            if [ -n "$_cand" ] && [ -f "$_cand" ]; then
                _cb="${_cand##*/}"; _cb="${_cb%.*}"
                [ "$_cb" = "$_tname" ] && _full="$_cand"   # only if it's THIS wallpaper
            fi
        fi
        if [ -z "$_full" ]; then
            for _f in "$HOME/wallpapers/$_tfolder/$_tname".*; do
                [ -f "$_f" ] && { _full="$_f"; break; }
            done
        fi
        if [ -z "$_full" ]; then
            _full="$(find "$HOME/wallpapers" -type f -name "$_tname.*" 2>/dev/null | head -n1)"
        fi
        [ -n "$_full" ] && [ -f "$_full" ] && img="$_full"
        ;;
esac

mkdir -p "$HOME/.cache/astralis"
# Serialize concurrent/rapid runs: matugen's Colors.json write + the base16
# read-modify-write below must not interleave with another setwall (a settings
# toggle can fire this back-to-back). flock queues runs; -w bounds the wait so a
# stuck run can't deadlock the next, and a missing flock degrades gracefully.
exec 9>"$HOME/.cache/astralis/setwall.lock"
flock -w 30 9 2>/dev/null || true
# Output dirs for the M3 baseline's new spotify/pywalfox templates (matugen writes
# them every run regardless of paletteMode; the tools that read them arrive later).
mkdir -p "$HOME/.cache/wal" "$HOME/.config/spicetify/Themes/Sleek" \
         "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" \
         "$HOME/.config/qt5ct/colors" "$HOME/.config/qt6ct/colors" \
         "$HOME/.config/fastfetch"
# Flag store + live palette file. FLAGS is overridable so a palette can be tested
# against a throwaway flags.json without touching the user's real one.
FLAGS_FILE="${FLAGS:-$HOME/.cache/astralis/flags.json}"
CJSON="$HOME/.config/quickshell/astralis/colors/Colors.json"

# Wallpaper DISPLAY is owned by skwd-wall: skwd-walld draws the picked image via its
# own skwd-paper engine (GPU shader transition), then calls this script
# (externalMatugenCommand) only to RE-THEME from it. setwall never sets the wallpaper
# itself. Any extra "$@" args are accepted for back-compat but unused.

# scheme-content follows the wallpaper's OWN colours faithfully → distinct palette per
# image. scheme-vibrant was the old default but it hue-collapses warm/red wallpapers to
# an identical pale pink (the "same colour for most wallpapers" bug); content keeps them
# distinct, and the chroma-rescue below re-adds saturation. Override with SCHEME=... .
matugen -m dark -t "${SCHEME:-scheme-content}" image "$img" || true   # rewrites Colors.json + hypr/cava/kitty/etc + fires post_hooks (best-effort)

# ── chroma rescue ────────────────────────────────────────────────────────────
# Material Color Utilities (matugen's engine) falls back to a FIXED seed
# (#4285f4, Google blue) when a wallpaper has no pixel colourful enough to score,
# and yields a washed palette for muted wallpapers — the "matugen defaulted to
# its own colour" case. The rescue re-seeds matugen from a colour derived from
# the wallpaper itself, gated by the "Wallpaper boost" setting (~/.cache/astralis
# /flags.json → wallReseed):
#   faithful → no boost (muted stays muted; grayscale still de-blued to neutral)
#   balanced → gentle proportional lift (default)
#   vivid    → strong lift
# A genuinely grayscale wallpaper (matugen invented blue, image has no tint) is
# re-run in scheme-neutral so it themes grey instead of blue. A washed seed's hue
# is only trusted when the image's average colour agrees (uniform tint = real;
# disagreement = noise from a near-grey seed). Skip everything with NORESCUE=1.
if [ -z "${NORESCUE:-}" ]; then
    action="$(FLAGS="$FLAGS_FILE" \
        CJSON="$CJSON" IMG="$img" python3 - <<'PY' 2>/dev/null
import os, json, colorsys, subprocess, sys
cj = os.environ["CJSON"]; img = os.environ["IMG"]; flg = os.environ.get("FLAGS", "")
FALLBACK = "#4285f4"; FLOOR = 0.38; TARGET_L = 0.50; NEUTRAL_AVG = 0.045; AGREE = 48.0 / 360.0
strength = "balanced"
try:
    strength = str(json.load(open(flg)).get("wallReseed", "balanced"))
except Exception:
    pass
def hsl(hexs):
    h = hexs.lstrip('#')
    r, g, b = int(h[0:2],16)/255, int(h[2:4],16)/255, int(h[4:6],16)/255
    hh, l, s = colorsys.rgb_to_hls(r, g, b); return hh, s, l
def hx(hue, s, l):
    r, g, b = colorsys.hls_to_rgb(hue, l, s)
    return "#%02x%02x%02x" % (round(r*255), round(g*255), round(b*255))
def avg():
    raw = subprocess.run(["ffmpeg","-i",img,"-vf","scale=1:1","-f","rawvideo","-pix_fmt","rgb24","-"],
                         capture_output=True).stdout
    if len(raw) < 3:
        return None
    h, l, s = colorsys.rgb_to_hls(raw[0]/255, raw[1]/255, raw[2]/255); return h, s
def dhue(a, b):
    d = abs(a - b) % 1.0; return min(d, 1.0 - d)
def target(seed_s):
    # None ⇒ don't boost (faithful). Otherwise the seed saturation to hand matugen.
    if strength == "vivid":    return 0.68
    if strength == "faithful": return None
    return min(0.55, seed_s + 0.22)          # balanced: gentle proportional lift
try:
    sc = json.load(open(cj)).get("source_color", "")
    if not sc:
        sys.exit(0)
    hue, s, l = hsl(sc)
    if sc.lower() == FALLBACK:
        # matugen invented blue. Recover the wallpaper's own faint tint if it has
        # one and a boost is allowed; a truly grey image themes neutral, not blue.
        a = avg()
        t = target(a[1]) if a else None
        if a and a[1] > NEUTRAL_AVG and t is not None:
            print("reseed " + hx(a[0], t, TARGET_L))
        else:
            print("neutral")
        sys.exit(0)
    if s >= FLOOR:
        sys.exit(0)                          # colourful enough — matugen's extraction stands
    t = target(s)
    if t is None:
        sys.exit(0)                          # faithful: leave the washed palette
    a = avg()
    if not a or a[1] < NEUTRAL_AVG:
        sys.exit(0)                          # neutral image → don't invent a colour
    if dhue(hue, a[0]) <= AGREE:
        print("reseed " + hx(hue, t, TARGET_L))
except Exception:
    pass
PY
)" || true
    case "$action" in
        reseed\ *) matugen -m dark -t "${SCHEME:-scheme-content}" color hex "${action#reseed }" || true ;;
        neutral)   matugen -m dark -t scheme-neutral image "$img" || true ;;   # grayscale → grey, not blue
    esac
fi

# ── base16 palette overlay (the "Palette" setting) ────────────────────────────
# Runs AFTER the M3 baseline + chroma rescue, so Colors.json holds the FINAL seed.
#   material  → nothing extra. The M3 baseline above already themed the shell AND
#               the apps, which also restores the app files from any prior base16 run.
#   vivid     → base16 from the final seed colour  (distinct, always-legible ANSI hues).
#   authentic → base16 from the raw image          (pywal-style, muddier on dark walls).
# The overlay re-themes only the apps (kitty/ghostty/spotify/browser) via
# config-base16-apps.toml. base16Shell also remaps Colors.json (surfaces/neutrals
# kept, accents → base16) through scripts/base16-to-colors. Runs on RETHEME_ONLY
# and NORESCUE runs too, so a settings toggle repaints live.
paletteMode="$(jq -r '.paletteMode // "material"' "$FLAGS_FILE" 2>/dev/null || echo material)"
base16Shell="$(jq -r '.base16Shell // false'      "$FLAGS_FILE" 2>/dev/null || echo false)"
if [ "$paletteMode" != "material" ] && [ "$paletteMode" != "null" ]; then
    if [ "$paletteMode" = "vivid" ]; then
        seed="$(jq -r '.source_color // empty' "$CJSON" 2>/dev/null || true)"
        if [ -n "$seed" ]; then SRC=(color hex "$seed"); else SRC=(image "$img"); fi
    else
        SRC=(image "$img")                       # authentic (and any unknown mode) → raw image
    fi
    # Apps overlay (prefer=darkness comes from the config so `image` needs no TTY).
    matugen -c "$HOME/.config/matugen/config-base16-apps.toml" -m dark -t scheme-vibrant "${SRC[@]}" >/dev/null 2>&1 || true
    # In `vivid` the source is a colour, so pywalfox's {{image}} → the literal "Null".
    # Stamp the real wallpaper path back in (same value in `authentic`) so colors.json
    # stays valid, then re-push to the browser.
    waljson="$HOME/.cache/wal/colors.json"
    if [ -f "$waljson" ] && command -v jq >/dev/null 2>&1; then
        tmpw="$waljson.$$"
        if jq --arg w "$img" '.wallpaper=$w' "$waljson" >"$tmpw" 2>/dev/null && [ -s "$tmpw" ]; then
            mv "$tmpw" "$waljson"
            command -v pywalfox >/dev/null 2>&1 && pywalfox update >/dev/null 2>&1 || true
        else
            rm -f "$tmpw"
        fi
    fi
    if [ "$base16Shell" = "true" ]; then
        remap="$HOME/.config/quickshell/astralis/scripts/base16-to-colors"
        b16json="$(matugen --dry-run -j hex --prefer darkness "${SRC[@]}" 2>/dev/null || true)"
        if [ -n "$b16json" ] && [ -x "$remap" ]; then
            tmp="$CJSON.b16.$$"
            if printf '%s' "$b16json" | uv run --script "$remap" "$CJSON" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
                mv "$tmp" "$CJSON"
            else
                rm -f "$tmp"
            fi
        fi
    fi
fi

# ── live-reload the terminals to the freshly rendered colours ─────────────────
# kitty reloads its config on SIGUSR1; ghostty on SIGUSR2 (Ghostty ≥1.2, we ship
# 1.3). Each re-reads its matugen colour file in place — no window restart, no
# focus steal, a no-op when the terminal isn't running. Runs in every mode
# (normal + RETHEME_ONLY) so a live palette/boost toggle repaints open terminals
# too. (Browser is already live via pywalfox update; GTK/Qt apply on next launch.)
pkill -USR1 -x kitty   2>/dev/null || true
pkill -USR2 -x ghostty 2>/dev/null || true

if [ -z "${RETHEME_ONLY:-}" ]; then
    printf '%s\n' "$img" > "$HOME/.cache/astralis/current-wallpaper"
fi
