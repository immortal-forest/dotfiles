#!/bin/sh
# astralis — idle dim / restore for every screen (hypridle's dim listener,
# generated by services/Hypridle.qml).
#   idle-dim dim      drop each screen to 40% of its CURRENT level
#   idle-dim release  put the external monitors back now, before they sleep
#   idle-dim restore  put each screen back
# Laptop panel: brightnessctl, floored at 1% of max, -s/-r save and restore.
# External monitors: ddcutil DDC/CI (VCP 0x10), floored at 1; the pre-dim
# level is saved per i2c bus. A lock makes a quick wake wait for a dim that is
# still talking to the monitor (~0.6 s per DDC call), so it can't end dim.
#
# DDC must never run while a monitor sleeps or wakes. The MSI drops off DP in
# standby and re-plugs as it wakes; DDC shares that link with the EDID read,
# and a restore fired at wake left it re-plugged with no modes (blank). So the
# screen-off listener and before_sleep_cmd call `release` while the monitor is
# still awake, and the restore at wake only has the panel left to do.
state="${XDG_RUNTIME_DIR:-/tmp}/astralis-idle-dim"

exec 9>"$state.lock"
flock 9

ddc_restore() {
    [ -f "$state" ] || return 0
    while read -r b c; do
        ddcutil --bus "$b" setvcp 10 "$c" --noverify 2>/dev/null
    done < "$state"
    rm -f "$state"
}

case "$1" in
dim)
    if command -v brightnessctl >/dev/null 2>&1; then
        cur=$(brightnessctl get); mx=$(brightnessctl max)
        t=$((cur * 2 / 5)); lo=$((mx / 100))
        [ "$t" -lt "$lo" ] && t=$lo
        brightnessctl -q -s set "$t"
    fi
    command -v ddcutil >/dev/null 2>&1 || exit 0
    # Screens already off (screen-off set shorter than dim): leave DDC alone.
    hyprctl monitors 2>/dev/null | grep -q 'dpmsStatus: 0' && exit 0
    : > "$state"
    for b in $(ddcutil detect --terse 2>/dev/null \
            | awk '/^Display/ { v = 1 } /^Invalid/ { v = 0 } v && /I2C bus/ { sub(/.*i2c-/, ""); print }'); do
        c=$(ddcutil --bus "$b" getvcp 10 --brief 2>/dev/null | awk '{ print $4 }')
        [ -n "$c" ] || continue
        echo "$b $c" >> "$state"
        t=$((c * 2 / 5))
        [ "$t" -lt 1 ] && t=1
        ddcutil --bus "$b" setvcp 10 "$t" --noverify 2>/dev/null
    done
    ;;
release)
    ddc_restore
    ;;
restore)
    command -v brightnessctl >/dev/null 2>&1 && brightnessctl -q -r >/dev/null
    ddc_restore
    ;;
*)
    echo "usage: idle-dim dim|release|restore" >&2
    exit 2
    ;;
esac
