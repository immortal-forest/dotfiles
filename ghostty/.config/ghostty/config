# Colours: generated per wallpaper by matugen (not in git). Optional include,
# so a fresh clone has no "theme not found" error before the first wallpaper.
config-file = ?themes/matugen

cursor-style = block

font-family = Obel Mono Lig
font-family = Symbols Nerd Font Mono
font-feature = calt
font-feature = ss01
font-size = 16

custom-shader = shaders/blaze.glsl
alpha-blending = linear-corrected


background-opacity = 0.80

window-decoration = false
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-save-state = always

shell-integration-features = no-cursor,sudo,title
shell-integration = detect
