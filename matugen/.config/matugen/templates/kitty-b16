# astralis — kitty colors (base16 palette), generated by matugen. Do not edit by hand.
# Include from kitty.conf:  include colors.conf
#
# Design (revised): NEUTRALS (bg/fg/black/white/gray/selection) come from the M3
# roles (surface/on_surface/outline) so the terminal is ALWAYS a dark, wallpaper-
# tinted bg with a near-white fg and real contrast — base16's raw base00/base05
# went near-black in vivid and washed-light in authentic, killing legibility.
# The 6 ANSI accents (color1-6) still ride the base16 slots (base08-0e) so the
# palette keeps its per-wallpaper / per-seed flavour. Mirrors the user's old
# pywal mapping (background->surface, foreground->on_surface, color8->gray).

foreground            {{colors.on_surface.default.hex}}
background            {{colors.surface.default.hex}}
selection_foreground  {{colors.surface.default.hex}}
selection_background  {{colors.on_surface.default.hex}}

cursor                {{base16.base0d.default.hex}}
cursor_text_color     {{colors.surface.default.hex}}

url_color             {{base16.base0d.default.hex}}

active_border_color   {{base16.base0d.default.hex}}
inactive_border_color {{colors.surface_container_high.default.hex}}

active_tab_foreground   {{colors.surface.default.hex}}
active_tab_background    {{base16.base0d.default.hex}}
inactive_tab_foreground {{colors.on_surface_variant.default.hex}}
inactive_tab_background  {{colors.surface_container.default.hex}}

# ANSI 16 — black/white/grey from M3 neutrals (contrast), colours 1-6 from base16.
