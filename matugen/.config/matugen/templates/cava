# astralis — cava config, generated by matugen. Do not edit by hand.
# This is the full cava config so matugen can regenerate a working file each retheme;
# only the [color] section is bound to M3 roles.

[general]
framerate = 60
autosens = 1
overshoot = 0
sensitivity = 100

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 3
# foreground + the 3 gradient stops track the M3 accent so the bars match the shell.
foreground = '{{colors.primary.default.hex}}'
background = '{{colors.surface.default.hex}}'
gradient_color_1 = '{{colors.primary.default.hex}}'
gradient_color_2 = '{{colors.primary_container.default.hex}}'
gradient_color_3 = '{{colors.tertiary.default.hex}}'

[smoothing]
noise_reduction = 77
