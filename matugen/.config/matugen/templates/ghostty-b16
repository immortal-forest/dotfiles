# astralis — ghostty colors (base16 palette), generated by matugen. Do not edit by hand.
# Load from ghostty config:  theme = matugen   (file lives in themes/matugen)
#
# Design (revised): NEUTRALS (bg/fg/black/white/grey/selection) come from the M3
# roles (surface/on_surface/outline) so the terminal is ALWAYS a dark, wallpaper-
# tinted bg with a near-white fg and real contrast — base16's raw base00/base05
# went near-black in vivid and washed-light in authentic, killing legibility.
# The 6 ANSI accents (palette 1-6) still ride the base16 slots (base08-0e) so the
# palette keeps its per-wallpaper / per-seed flavour.

background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}

cursor-color = {{base16.base0d.default.hex}}
cursor-text = {{colors.surface.default.hex}}

selection-background = {{colors.on_surface.default.hex}}
selection-foreground = {{colors.surface.default.hex}}

# ANSI 16 — black/white/grey from M3 neutrals (contrast), colours 1-6 from base16.
palette = 0={{colors.surface.default.hex}}
palette = 8={{colors.outline.default.hex}}
palette = 1={{base16.base08.default.hex}}
palette = 9={{base16.base08.default.hex}}
palette = 2={{base16.base0b.default.hex}}
palette = 10={{base16.base0b.default.hex}}
palette = 3={{base16.base0a.default.hex}}
palette = 11={{base16.base0a.default.hex}}
palette = 4={{base16.base0d.default.hex}}
palette = 12={{base16.base0d.default.hex}}
palette = 5={{base16.base0e.default.hex}}
palette = 13={{base16.base0e.default.hex}}
palette = 6={{base16.base0c.default.hex}}
palette = 14={{base16.base0c.default.hex}}
palette = 7={{colors.on_surface_variant.default.hex}}
palette = 15={{colors.on_surface.default.hex}}
