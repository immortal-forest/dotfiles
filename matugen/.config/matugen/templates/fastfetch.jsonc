// astralis — fastfetch config, generated by matugen. Do NOT edit by hand —
// regenerated on wallpaper change via ~/.config/matugen/config.toml
// [templates.fastfetch]. Edit ~/.config/matugen/templates/fastfetch.jsonc instead.
//
// Minimal by intent: one screenful of the things that actually change, no
// section headers, no progress bars, no duplicate rows. Icons all come from the
// Nerd Fonts Material Design set (nf-md-*, U+F0000+), each verified present in
// CaskaydiaCove Nerd Font — a key with no glyph renders as a blank gap.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "2": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}"
    },
    "padding": { "top": 1, "right": 8 }
  },

  "display": {
    "color": {
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "title": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
      "separator": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}"
    },
    // Keys are padded to a fixed width, so the values line up on their own —
    // no separator glyph needed. (Nerd Font icons occupy two cells.)
    "key": { "width": 12 },
    "separator": "",
    // Numbers only. Bars read as clutter at this size.
    "percent": { "type": 1 },
    "size": { "maxPrefix": "GB", "ndigits": 1 }
  },

  "modules": [
    "title",
    "separator",

    { "type": "os",       "key": "󰣇  os" },
    { "type": "kernel",   "key": "󰌽  kernel", "format": "{release}" },
    { "type": "uptime",   "key": "󰅐  uptime" },
    { "type": "packages", "key": "󰏖  pkgs",   "format": "{pacman}" },
    { "type": "shell",    "key": "󰆍  shell" },
    { "type": "wm",       "key": "󱄄  wm",     "format": "{pretty-name}" },
    { "type": "terminal", "key": "󰞷  term",   "format": "{pretty-name}" },
    { "type": "cpu",      "key": "󰻠  cpu",    "format": "{name}" },
    // Hybrid graphics — the discrete card only; the iGPU row was noise.
    { "type": "gpu",      "key": "󰢮  gpu",    "format": "{name}", "hideType": "integrated" },
    { "type": "memory",   "key": "󰍛  memory" },
    { "type": "disk",     "key": "󰋊  disk",   "folders": "/" },

    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
